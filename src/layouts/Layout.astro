---
import { ClientRouter } from 'astro:transitions'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  /** Page background; project pages match their circle's color. */
  background?: string
}

const { title, description, background } = Astro.props
---

<!doctype html>
<html
  lang="en"
  class="bg-paper font-sans text-ink antialiased"
  style={background && `background-color: ${background}`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Matthew Muiter" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <slot />
    <script src="../scripts/project-transition.ts"></script>
  </body>
</html>
