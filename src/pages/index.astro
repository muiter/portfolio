---
import Layout from '../layouts/Layout.astro'
import ProjectGrid from '../components/ProjectGrid.astro'
import SocialLinks from '../components/SocialLinks.astro'
import { site } from '../data/site'
import { experience } from '../data/experience'

// Section headings match the CV: serif, underlined to the width of the text.
// Each links to its own section, so it can be clicked or shared.
const heading = 'inline-block border-b-2 border-ink pb-1 font-serif text-2xl text-ink sm:text-3xl'
const headingLink = 'transition-colors hover:text-muted focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink'
---

<Layout title={site.name} description={`Projects and work by ${site.name}`}>
  <header class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-5 gap-y-4 px-6 pt-16 pb-12 sm:pt-24 sm:pb-16">
    <h1 class="font-serif text-5xl font-semibold tracking-tight text-ink sm:text-6xl">{site.name}</h1>
    <SocialLinks />
  </header>

  <main class="mx-auto max-w-5xl px-6 pb-24">
    <section id="projects" class="scroll-mt-8" aria-labelledby="projects-heading">
      <h2 id="projects-heading" class:list={[heading, 'mb-8 sm:mb-12']}>
        <a href="#projects" data-smooth-scroll class={headingLink}>Projects</a>
      </h2>
      <ProjectGrid />
    </section>

    <section id="experience" aria-labelledby="experience-heading" class="mt-24 scroll-mt-8 sm:mt-32">
      <h2 id="experience-heading" class={heading}>
        <a href="#experience" data-smooth-scroll class={headingLink}>Experience</a>
      </h2>
      <ol class="mt-8 space-y-10">
        {experience.map((job) => (
          <li>
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <h3 class="text-lg text-muted">
                <span class="font-medium text-ink">{job.title} at {job.company}</span>
                <span aria-hidden="true" class="hidden sm:inline"> | </span>
                <span class="sr-only">, </span>
                <span class="block sm:inline">{job.location}</span>
              </h3>
              <p class="text-muted tabular-nums">{job.period}</p>
            </div>
            <ul class="mt-3 list-disc space-y-2 pl-5 leading-relaxed text-ink marker:text-ink">
              {job.highlights.map((highlight) => <li class="pl-1">{highlight}</li>)}
            </ul>
            <p class="mt-3 pl-6 text-sm leading-relaxed text-muted">Technologies: {job.technologies}</p>
          </li>
        ))}
      </ol>
    </section>
  </main>
</Layout>

<script>
  // Only these links scroll smoothly; the rest of the page (e.g. returning
  // from a project) keeps instant scrolling. Turn smooth scrolling on just
  // before the router scrolls to the section, and off once it arrives.
  document.addEventListener(
    'click',
    (event) => {
      if (!(event.target as Element).closest('a[data-smooth-scroll]')) return
      const root = document.documentElement
      root.style.scrollBehavior = 'smooth'
      const reset = () => root.style.removeProperty('scroll-behavior')
      addEventListener('scrollend', reset, { once: true })
      // Fallback for browsers without scrollend, or when already in place.
      setTimeout(reset, 1500)
    },
    { capture: true },
  )
</script>
