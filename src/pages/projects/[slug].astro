---
import type { GetStaticPaths } from 'astro'
import Layout from '../../layouts/Layout.astro'
import Gallery from '../../components/Gallery.tsx'
import { projects } from '../../data/projects'
import { site } from '../../data/site'
import { galleryItems } from '../../lib/images'
import { projectColor } from '../../lib/projectColors'
import { homeUrl } from '../../lib/urls'

export const getStaticPaths = (() =>
  projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }))) satisfies GetStaticPaths

const { project } = Astro.props
const gallery = await galleryItems(project.slug, project.images)

// Live sites show without "https://" and "www.", e.g. bitvavo.com/en/markets.
const liveSites = (project.urls ?? [])
  .filter(Boolean)
  .map((href) => ({ href, text: href.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '') }))

const details: { label: string; text?: string; links?: { href: string; text: string }[] }[] = [
  { label: liveSites.length > 1 ? 'Live Sites' : 'Live Site', links: liveSites },
  { label: 'Task', text: project.task },
  { label: 'Issue(s)', text: project.problem },
  { label: 'Solution', text: project.solution },
  { label: 'More Context', text: project.context },
].filter((detail) => detail.text || detail.links?.length)
---

<Layout title={`${project.title} · ${site.name}`} description={project.task} background={projectColor}>
  <a
    href={homeUrl}
    data-back
    data-astro-prefetch="load"
    aria-label="Back to all projects"
    class="fixed top-4 left-4 z-10 flex size-12 items-center justify-center rounded-full bg-paper text-ink shadow-lg transition hover:scale-105 focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-paper sm:top-6 sm:left-6"
  >
    <svg aria-hidden="true" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
      <path d="M19 12H5M12 19l-7-7 7-7" />
    </svg>
  </a>

  <main class="px-6 pt-28 pb-24 text-paper sm:pt-24">
    <article class="mx-auto max-w-3xl">
      <h1 class="font-serif text-4xl font-semibold leading-tight tracking-tight text-balance sm:text-6xl">{project.title}</h1>

      <dl class="mt-14 space-y-10">
        {details.map((detail) => (
          <div>
            <dt class="text-xs font-semibold tracking-[0.2em] text-paper/60 uppercase">{detail.label}</dt>
            <dd class="mt-3 text-lg leading-relaxed text-paper/90">
              {detail.links ? (
                <ul class="space-y-2">
                  {detail.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="underline decoration-paper/40 underline-offset-4 transition hover:decoration-paper focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-paper"
                      >
                        {link.text}
                        <svg aria-hidden="true" class="ml-1 inline size-4 align-[-0.1em]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M7 17 17 7M9 7h8v8" />
                        </svg>
                        <span class="sr-only">(opens in a new tab)</span>
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                detail.text
              )}
            </dd>
          </div>
        ))}
      </dl>
    </article>

    {gallery.length > 0 && (
      <section aria-label="Images" class="mx-auto mt-20 max-w-5xl">
        <Gallery client:visible items={gallery} />
      </section>
    )}
  </main>
</Layout>
